{
  "layer": "top",
  "position": "top",
  "height": 28,
  "margin": "5 8 0 8",
  "reload_style_on_change": true,

  "group/right": {
    "orientation": "horizontal",
    "modules": ["bluetooth", "group/group-volume", "network"],
  },

  "modules-left": ["custom/pacman", "mpris"],
  "modules-center": ["hyprland/workspaces"],
  "modules-right": ["tray", "custom/countdown", "custom/weather", "group/right", "clock"],

  "include": ["~/.config/waybar/modules.jsonc", "~/.config/waybar/clock.jsonc"],
}
