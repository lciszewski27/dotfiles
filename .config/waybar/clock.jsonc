{
  "clock": {
"format": "{:%H:%M}",

    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "format-alt": "{:%Y年%m月%d日 %H:%M}",
    "on-click-right": "hyprctl dispatch exec 'gnome-control-center datetime'",
    "calendar": {
      "mode": "year",
      "weeks-pos": "right",
      "mode-mon-col": 3,
      "format": {
        "months": "<span color='#cdc3d1'><b>{}</b></span>",
        "days": "<span color='#cdc3d1'><b>{}</b></span>",
        "weeks": "<span color='#dab9ff'><b>W{}</b></span>",
        "weekdays": "<span color='#ecb6e3'><b>{}</b></span>",
        "today": "<span color='#dbbde2'><b><u>{}</u></b></span>",
      },
    },
  },
}
