# Generated by Matugen from /home/lukasz/Pictures/Wallpapers/night.png
# Dunst follows the system theme: re-run theme-chnage.sh (or matugen) after
# changing wallpaper / light-dark mode to regenerate this file.

[global]
    font = "Quicksand 11, GeistMono Nerd Font 11, FontAwesome 11"
    allow_markup = yes
    markup = yes
    # Cozy layer: a small heart on every notification title.
    # Remove the "💜 " prefix here to turn it off. Apps can also put their
    # own emoji in the summary — Dunst renders either way.
    format = "<span foreground='#dab9ff'><b>💜 %s</b></span>\n%b"
    sort = yes
    indicate_hidden = yes
    bounce_freq = 0
    show_age_threshold = 60
    word_wrap = yes
    ignore_newline = false
    origin = bottom-center
    transparency = 0
    idle_threshold = 120
    monitor = 0
    follow = mouse
    sticky_history = yes
    line_height = 0
    separator_height = 2
    padding = 12
    horizontal_padding = 12
    separator_color = "#423b48"
    separator_width = 1
    gap_size = 8
    startup_notification = false
    corner_radius = 20
    # Accent border like active Hyprland windows (border_size 2 there too).
    frame_color = "#dab9ff"
    frame_width = 2
    width = 400
    progress_bar_max_width = 400
    progress_bar_min_width = 400
    progress_bar_height = 10
    progress_bar_frame_width = 1
    progress_bar_corner_radius = 5
    scale = 1
    min_icon_size = 64
    max_icon_size = 64
    alignment = center
    vertical_alignment = center

[shortcuts]
    close = ctrl+space
    close_all = ctrl+shift+space
    history = ctrl+grave
    context = ctrl+shift+period

[urgency_low]
    # E6 alpha (~90% opaque): lets Hyprland's blur show through for a frosted
    # look (dunst `transparency` is X11-only; on Wayland alpha lives in the color).
    background = "#2d2734E6"
    foreground = "#e9dfee"
    highlight = "#dab9ff"
    timeout = 5

[urgency_normal]
    background = "#2d2734E6"
    foreground = "#e9dfee"
    highlight = "#dab9ff"
    timeout = 20

[urgency_critical]
    background = "#93000aE6"
    foreground = "#ffdad6"
    highlight = "#dab9ff"
    frame_color = "#ffb4ab"
    timeout = 0
