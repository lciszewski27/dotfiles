# Generated by Matugen from {{image}}
# Dunst follows the system theme: re-run theme-chnage.sh (or matugen) after
# changing wallpaper / light-dark mode to regenerate this file.

[global]
    font = "Quicksand 11, GeistMono Nerd Font 11, FontAwesome 11"
    allow_markup = yes
    markup = yes
    # Cozy layer: a small heart on every notification title.
    # Remove the "💜 " prefix here to turn it off. Apps can also put their
    # own emoji in the summary — Dunst renders either way.
    format = "<span foreground='{{colors.primary.default.hex}}'><b>💜 %s</b></span>\n%b"
    sort = yes
    indicate_hidden = yes
    bounce_freq = 0
    show_age_threshold = 60
    word_wrap = yes
    ignore_newline = false
    origin = bottom-center
    transparency = 0
    idle_threshold = 120
    monitor = 0
    follow = mouse
    sticky_history = yes
    line_height = 0
    separator_height = 2
    padding = 12
    horizontal_padding = 12
    separator_color = "{{colors.surface_container_highest.default.hex | lighten:4}}"
    separator_width = 1
    gap_size = 8
    startup_notification = false
    corner_radius = 20
    # Accent border like active Hyprland windows (border_size 2 there too).
    frame_color = "{{colors.primary.default.hex}}"
    frame_width = 2
    width = 400
    progress_bar_max_width = 400
    progress_bar_min_width = 400
    progress_bar_height = 10
    progress_bar_frame_width = 1
    progress_bar_corner_radius = 5
    scale = 1
    min_icon_size = 64
    max_icon_size = 64
    alignment = center
    vertical_alignment = center

[shortcuts]
    close = ctrl+space
    close_all = ctrl+shift+space
    history = ctrl+grave
    context = ctrl+shift+period

[urgency_low]
    # E6 alpha (~90% opaque): lets Hyprland's blur show through for a frosted
    # look (dunst `transparency` is X11-only; on Wayland alpha lives in the color).
    background = "{{colors.surface_container.default.hex | lighten:4}}E6"
    foreground = "{{colors.on_surface.default.hex}}"
    highlight = "{{colors.primary.default.hex}}"
    timeout = 5

[urgency_normal]
    background = "{{colors.surface_container.default.hex | lighten:4}}E6"
    foreground = "{{colors.on_surface.default.hex}}"
    highlight = "{{colors.primary.default.hex}}"
    timeout = 20

[urgency_critical]
    background = "{{colors.error_container.default.hex}}E6"
    foreground = "{{colors.on_error_container.default.hex}}"
    highlight = "{{colors.primary.default.hex}}"
    frame_color = "{{colors.error.default.hex}}"
    timeout = 0
